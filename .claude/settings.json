{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  },
  "enabledPlugins": {
    "cc-suite@xiaolai": true,
    "loc-guardian@xiaolai": true,
    "echo-sleuth@xiaolai": true
  },
  "extraKnownMarketplaces": {
    "xiaolai": {
      "source": {
        "source": "github",
        "repo": "xiaolai/claude-plugin-marketplace"
      }
    }
  }
}
