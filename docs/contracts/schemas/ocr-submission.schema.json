{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litigation-platform.local/contracts/ocr-submission.schema.json",
  "title": "OcrSubmission",
  "description": "Web app -> queue -> OCR worker. See docs/contracts/ocr-worker-contract.md §1.",
  "type": "object",
  "required": [
    "contract_version",
    "job_id",
    "tenant_id",
    "document_id",
    "document_revision",
    "submitted_at",
    "submitted_by",
    "pages",
    "ocr_options",
    "preprocessing",
    "priority",
    "retry",
    "metadata"
  ],
  "properties": {
    "contract_version": { "$ref": "#/$defs/semver" },
    "job_id":      { "$ref": "#/$defs/ulid" },
    "tenant_id":   { "$ref": "#/$defs/ulid" },
    "case_id":     { "$ref": "#/$defs/ulid" },
    "document_id": { "$ref": "#/$defs/ulid" },
    "document_revision": { "type": "integer", "minimum": 1 },
    "submitted_at": { "type": "string", "format": "date-time" },
    "submitted_by": { "type": "string", "minLength": 1 },

    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pageRef" }
    },

    "rerun": {
      "type": "object",
      "required": ["is_rerun"],
      "properties": {
        "is_rerun": { "type": "boolean" },
        "previous_job_id": { "anyOf": [{ "$ref": "#/$defs/ulid" }, { "type": "null" }] },
        "page_ids": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/ulid" }, "minItems": 1 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "is_rerun": { "const": true } }, "required": ["is_rerun"] },
          "then": {
            "required": ["previous_job_id", "page_ids"],
            "properties": {
              "previous_job_id": { "$ref": "#/$defs/ulid" },
              "page_ids": { "type": "array", "items": { "$ref": "#/$defs/ulid" }, "minItems": 1 }
            }
          }
        }
      ]
    },

    "ocr_options": {
      "type": "object",
      "required": ["languages"],
      "properties": {
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "detect_orientation": { "type": "boolean" },
        "detect_vertical_text": { "type": "boolean" },
        "table_recognition": { "enum": ["off", "auto", "force"] },
        "seal_recognition": { "type": "boolean" },
        "return_word_confidence": { "type": "boolean" },
        "return_polygon": { "type": "boolean" },
        "min_confidence_emit": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "preprocessing": {
      "type": "object",
      "properties": {
        "deskew":            { "enum": ["off", "auto", "force"] },
        "denoise":           { "enum": ["off", "auto", "aggressive"] },
        "binarize":          { "type": "boolean" },
        "remove_seal_bleed": { "type": "boolean" },
        "upscale_low_dpi":   { "type": "boolean" },
        "target_dpi_floor":  { "type": "integer", "minimum": 50, "maximum": 1200 },
        "crop_borders":      { "enum": ["off", "auto"] }
      }
    },

    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Higher = more urgent. Range 0-100 inclusive."
    },

    "deadline": { "type": "string", "format": "date-time" },

    "retry": {
      "type": "object",
      "required": ["max_attempts", "backoff", "base_delay_ms", "max_delay_ms", "attempt"],
      "properties": {
        "max_attempts":  { "type": "integer", "minimum": 1, "maximum": 20 },
        "backoff":       { "enum": ["fixed", "exponential"] },
        "base_delay_ms": { "type": "integer", "minimum": 0 },
        "max_delay_ms":  { "type": "integer", "minimum": 0 },
        "attempt":       { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "description": "attempt must not exceed max_attempts",
          "if": { "required": ["attempt", "max_attempts"] },
          "then": {
            "properties": {
              "attempt":      { "type": "integer" },
              "max_attempts": { "type": "integer" }
            }
          }
        }
      ]
    },

    "metadata": { "type": "object" }
  },

  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$",
      "description": "Lowercase 26-char ULID. Conventionally Crockford base32 (no i/l/o/u), but the schema accepts the broader [0-9a-z] alphabet so fixtures and stub IDs aren't blocked. Producers SHOULD emit valid Crockford ULIDs."
    },
    "pageRef": {
      "type": "object",
      "required": ["page_id", "page_number", "source"],
      "properties": {
        "page_id":     { "$ref": "#/$defs/ulid" },
        "page_number": { "type": "integer", "minimum": 1 },
        "source":      { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "bucket", "key"],
          "properties": {
            "kind":   { "const": "s3" },
            "bucket": { "type": "string", "minLength": 1 },
            "key":    { "type": "string", "minLength": 1 },
            "etag":   { "type": "string" },
            "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" },
            "byte_size": { "type": "integer", "minimum": 1 },
            "mime_type": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "https" },
            "url":  { "type": "string", "format": "uri", "pattern": "^https://" },
            "url_expires_at": { "type": "string", "format": "date-time" },
            "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" },
            "byte_size": { "type": "integer", "minimum": 1 },
            "mime_type": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "base64", "byte_size"],
          "properties": {
            "kind":   { "const": "inline" },
            "base64": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/=\\n\\r]+$" },
            "byte_size": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "mime_type": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
