{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litigation-platform.local/contracts/ocr-job-outcome.schema.json",
  "title": "OcrJobOutcome",
  "description": "Production return shape of OcrWorker.process(job). See ADR-11A.5 v0.1. Engine-shaped mapping rules (reading order, bbox, confidence aggregation, etc.) are deferred to v1.0 post-bakeoff.",
  "type": "object",
  "required": ["job_id", "statuses", "results", "terminal_state"],
  "additionalProperties": true,
  "properties": {
    "job_id": { "$ref": "#/$defs/ulid" },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transitionRecord" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "https://litigation-platform.local/contracts/ocr-result.schema.json#" }
    },
    "terminal_state": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9a-z]{26}$" },
    "state": {
      "enum": [
        "queued",
        "claimed",
        "processing",
        "succeeded",
        "failed",
        "partial_succeeded",
        "cancelled",
        "dead_lettered"
      ]
    },
    "actor": { "enum": ["queue", "worker", "web_app"] },
    "transitionRecord": {
      "type": "object",
      "required": ["from", "to", "controlled_by", "at"],
      "properties": {
        "from": { "$ref": "#/$defs/state" },
        "to":   { "$ref": "#/$defs/state" },
        "controlled_by": { "$ref": "#/$defs/actor" },
        "at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    }
  }
}
