{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litigation-platform.local/case-box-contract/case-box-docket-entry.schema.json",
  "title": "CaseBoxDocketEntry",
  "description": "Docket-entry proposal companion to CaseBoxDeadline. Carries provenance + confirmation lifecycle + authoritative date-only/timezone semantics. CaseBoxDeadline (Step 1) becomes a materialized-view projection; the docket entry is the authoritative source for legal date semantics. ALL entries start as proposed; lawyer must explicitly confirm or dismiss. date_only confirmation is FORBIDDEN in v1 (no jurisdiction/timezone resolver). See docs/adr/case-box-step-6-deadline-docketing-rules.md.",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "actor_user_id",
    "matter_id",
    "source_type",
    "proposed_kind",
    "proposed_due_at",
    "proposed_due_at_kind",
    "proposed_due_at_timezone",
    "proposed_owner_user_id",
    "source_rule_citation",
    "extractor_name",
    "extractor_version",
    "extraction_confidence",
    "source_document_id",
    "source_page_number",
    "source_excerpt",
    "reminder_offsets",
    "confirmation_state",
    "proposed_at",
    "confirmation_actor_user_id",
    "confirmed_at",
    "confirmed_deadline_id",
    "dismissal_actor_user_id",
    "dismissed_at",
    "dismissal_reason",
    "created_at"
  ],
  "properties": {
    "id":            { "$ref": "#/$defs/ulid" },
    "tenant_id":     { "type": "string", "minLength": 1 },
    "actor_user_id": { "type": "string", "minLength": 1, "description": "Proposer." },
    "matter_id":     { "$ref": "#/$defs/ulid" },
    "source_type": {
      "enum": ["manual", "court_order_excerpt", "llm_extraction", "imported"]
    },
    "proposed_kind": {
      "enum": ["statute_of_limitations", "court_order", "discovery", "filing", "hearing", "internal"]
    },
    "proposed_due_at": { "type": "string", "format": "date-time" },
    "proposed_due_at_kind": { "enum": ["datetime", "date_only"] },
    "proposed_due_at_timezone": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ],
      "description": "IANA timezone (semantic IANA validity enforced by assertValidIanaTimezone TS helper). Required non-null when proposed_due_at_kind === datetime (D7)."
    },
    "proposed_owner_user_id": { "type": "string", "minLength": 1 },
    "source_rule_citation": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "extractor_name": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ],
      "description": "Required for llm_extraction (D2) + imported (D3). MUST be null for manual (D1)."
    },
    "extractor_version": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "extraction_confidence": {
      "anyOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ]
    },
    "source_document_id": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ulid" }
      ],
      "description": "Required for court_order_excerpt (D4)."
    },
    "source_page_number": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "source_excerpt": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "reminder_offsets": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["offset_days", "kind"],
            "additionalProperties": false,
            "properties": {
              "offset_days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3650,
                "description": "Days BEFORE the due date. Non-negative; after-due-date semantics deferred."
              },
              "kind": { "enum": ["advance_notice", "final_notice"] }
            }
          }
        }
      ],
      "description": "v1 shape-only; no notification execution."
    },
    "confirmation_state": { "enum": ["proposed", "confirmed", "dismissed"] },
    "proposed_at": { "type": "string", "format": "date-time" },
    "confirmation_actor_user_id": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "confirmed_at": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "confirmed_deadline_id": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ulid" }
      ]
    },
    "dismissal_actor_user_id": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "dismissed_at": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "dismissal_reason": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if":   { "properties": { "confirmation_state": { "const": "proposed" } }, "required": ["confirmation_state"] },
      "then": {
        "properties": {
          "confirmation_actor_user_id": { "type": "null" },
          "confirmed_at":               { "type": "null" },
          "confirmed_deadline_id":      { "type": "null" },
          "dismissal_actor_user_id":    { "type": "null" },
          "dismissed_at":               { "type": "null" },
          "dismissal_reason":           { "type": "null" }
        }
      }
    },
    {
      "if":   { "properties": { "source_type": { "const": "manual" } }, "required": ["source_type"] },
      "then": {
        "properties": {
          "extractor_name":        { "type": "null" },
          "extractor_version":     { "type": "null" },
          "extraction_confidence": { "type": "null" }
        }
      }
    },
    {
      "if":   { "properties": { "source_type": { "const": "llm_extraction" } }, "required": ["source_type"] },
      "then": {
        "required": ["extractor_name"],
        "properties": { "extractor_name": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if":   { "properties": { "source_type": { "const": "imported" } }, "required": ["source_type"] },
      "then": {
        "required": ["extractor_name"],
        "properties": { "extractor_name": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if":   { "properties": { "source_type": { "const": "court_order_excerpt" } }, "required": ["source_type"] },
      "then": {
        "required": ["source_document_id", "source_page_number", "source_excerpt"],
        "properties": {
          "source_document_id": { "$ref": "#/$defs/ulid" },
          "source_page_number": { "type": "integer", "minimum": 1 },
          "source_excerpt":     { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if":   { "properties": { "confirmation_state": { "const": "confirmed" } }, "required": ["confirmation_state"] },
      "then": {
        "required": ["confirmation_actor_user_id", "confirmed_at", "confirmed_deadline_id"],
        "properties": {
          "confirmation_actor_user_id": { "type": "string", "minLength": 1 },
          "confirmed_at":               { "type": "string", "format": "date-time" },
          "confirmed_deadline_id":      { "$ref": "#/$defs/ulid" },
          "dismissal_actor_user_id":    { "type": "null" },
          "dismissed_at":               { "type": "null" },
          "dismissal_reason":           { "type": "null" }
        }
      }
    },
    {
      "if":   { "properties": { "confirmation_state": { "const": "dismissed" } }, "required": ["confirmation_state"] },
      "then": {
        "required": ["dismissal_actor_user_id", "dismissed_at", "dismissal_reason"],
        "properties": {
          "dismissal_actor_user_id":    { "type": "string", "minLength": 1 },
          "dismissed_at":               { "type": "string", "format": "date-time" },
          "dismissal_reason":           { "type": "string", "minLength": 1 },
          "confirmation_actor_user_id": { "type": "null" },
          "confirmed_at":               { "type": "null" },
          "confirmed_deadline_id":      { "type": "null" }
        }
      }
    },
    {
      "if":   { "properties": { "proposed_due_at_kind": { "const": "datetime" } }, "required": ["proposed_due_at_kind"] },
      "then": {
        "required": ["proposed_due_at_timezone"],
        "properties": { "proposed_due_at_timezone": { "type": "string", "minLength": 1 } }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9a-z]{26}$" }
  }
}
