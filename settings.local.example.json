// .claude/settings.local.json  — EXAMPLE per-repo promotion overlay (NOT committed).
// Local settings override project settings, so use this to PROMOTE dormant plugins
// for a specific repo once its work actually calls for them. Delete what you don't need.
//
// This example fits a UI-heavy repo with lots of markdown/agent artifacts.
// For a plain backend repo you might promote only tdd-guardian + loc-guardian instead.
{
  "enabledPlugins": {
    "ui-tokenize@xiaolai": true,
    "ui-responsive@xiaolai": true,
    "nlpm@xiaolai": true
  }
}
