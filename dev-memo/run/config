# Auto-advance run config. Sourced by the workflow.
# AUTO_ADVANCE_MAX = consecutive WIs that may auto-commit + advance with NO human between.
#   1  = gated mode (stop after every WI). Use when learning a new area.
#   3  = canary autonomous batch (prove the queue is sound before a full run).
#   10 = full autonomous batch.
# The agent only advances through WIs already in queue.md; it never invents the next task.
AUTO_ADVANCE_MAX=3

# BATCH_AUDIT_EVERY = run the major audit + echo-sleuth study packet after this many commits.
BATCH_AUDIT_EVERY=3
