# ClauDepot credentials — the shape only. Copy to .env and fill it in there.
# .env is already gitignored (see the "Secrets / env" block in .gitignore).
#
# Mint the token at https://claudepot.com/settings/tokens with exactly these scopes:
#   read:all
#   submission:write
#   comment:write
#
# Never paste this token into a chat session, and never commit it.
# This file's value stays empty, permanently.
CLAUDEPOT_PAT=
