{
  "name": "ocr-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain-facing ingestion layer that turns legal document/page records into OCR submissions and drives them through the queue + persistence boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/ingestion.test.mjs"
  },
  "dependencies": {
    "ocr-worker-contract": "file:../../docs/contracts",
    "ocr-worker-adapter": "file:../ocr-worker",
    "ocr-persistence": "file:../ocr-persistence"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
